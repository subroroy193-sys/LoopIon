        <mxCell id="xX_1lbu7gcvtT0vsC2jS-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h1 data-section-id=&quot;fg7trk&quot; data-start=&quot;6139&quot; data-end=&quot;6162&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;15. Lifecycle Module&lt;/h1&gt;&lt;div&gt;&lt;p data-start=&quot;8446&quot; data-end=&quot;8491&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;This tracks where the battery is in its life.&lt;/p&gt;&lt;p data-start=&quot;8493&quot; data-end=&quot;8505&quot;&gt;For example:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;8507&quot; data-end=&quot;8612&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;Manufactured&lt;br&gt;     ↓&lt;br&gt;Sold&lt;br&gt;     ↓&lt;br&gt;In Service&lt;br&gt;     ↓&lt;br&gt;Serviced&lt;br&gt;     ↓&lt;br&gt;Second Li