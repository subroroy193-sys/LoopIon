    <mxGraphModel dx="1373" dy="749" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="xX_1lbu7gcvtT0vsC2jS-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h1 data-section-id=&quot;wjtrjn&quot; data-start=&quot;1026&quot; data-end=&quot;1040&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;1. SAP / ERP&lt;/h1&gt;&lt;p data-start=&quot;1042&quot; data-end=&quot;1088&quot;&gt;Let&#39;s say a battery manufacturer uses &lt;strong data-start=&quot;1080&quot; data-end=&quot;1087&quot;&gt;SAP&lt;/strong&gt;&lt;/p&gt;&lt;p data-start=&quot;1090&quot; data-end=&quot;1147&quot;&gt;SAP knows the &lt;strong data-start=&quot;1104&quot; data-end=&quot;1128&quot;&gt;business information&lt;/strong&gt; about the battery&lt;/p&gt;&lt;p data-start=&quot;1149&quot; data-end=&quot;1161&quot;&gt;For example:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1163&quot; data-end=&quot;1343&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;Battery Serial Number: BAT-000001&lt;br&gt;Customer: ABC Motors&lt;br&gt;Dealer: XYZ Dealer&lt;br&gt;Manufacturing Cost: ₹50,000&lt;br&gt;Selling Price: ₹70,000&lt;br&gt;Warranty: 5 Years&lt;br&gt;Invoice Number: INV-12345&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;" vertex="1">
