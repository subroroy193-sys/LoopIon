        <mxCell id="xX_1lbu7gcvtT0vsC2jS-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h1 data-section-id=&quot;wjtrjn&quot; data-start=&quot;1026&quot; data-end=&quot;1040&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;br&gt;&lt;p data-start=&quot;5784&quot; data-end=&quot;5825&quot;&gt;&lt;/p&gt;&lt;/h1&gt;&lt;h1 data-section-id=&quot;tscg99&quot; data-start=&quot;5774&quot; data-end=&quot;5782&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;9. BMS&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;p data-start=&quot;5784&quot; data-end=&quot;5825&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;Now the battery is out in the real world.&lt;/p&gt;&lt;p data-start=&quot;5827&quot; data-end=&quot;5881&quot;&gt;The battery has a &lt;strong data-start=&quot;5845&quot; data-end=&quot;5880&quot;&gt;BMS — Battery Management System&lt;/strong&gt;.&lt;/p&gt;&lt;p data-start=&quot;5883&quot; data-end=&quot;5912&quot;&gt;The BMS monitors the battery.&lt;/p&gt;&lt;p data-start=&quot;5914&quot; data-end=&quot;5926&quot;&gt;It may know:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;5928&quot; data-end=&quot;5998&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;Voltage&lt;br&gt;Current&lt;br&gt;Temperature&lt;br&gt;SOC&lt;br&gt;SOH&lt;br&gt;Charging cycles&lt;br&gt;Faults&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="380" x="20" y="720" as="geometry" />
        </mxCell>
        <mxCell id="xX_1lbu7gcvtT0vsC2jS-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h1 data-section-id=&quot;fg7trk&quot; data-start=&quot;6139&quot; data-end=&quot;6162&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;10. BMS / IoT Gateway&lt;/h1&gt;&lt;p data-start=&quot;6164&quot; data-end=&quot;6244&quot;&gt;The BMS knows the information, but it may not directly communicate with Looplon.&lt;/p&gt;&lt;p data-start=&quot;6246&quot; data-end=&quot;6262&quot;&gt;So you may have:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6264&quot; data-end=&quot;6346&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;Battery&lt;br&gt;   ↓&lt;br&gt;BMS&lt;br&gt;   ↓&lt;br&gt;Vehicle / IoT Gateway&lt;br&gt;   ↓&lt;br&gt;Internet&lt;br&gt;   ↓&lt;br&gt;Looplon&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;6348&quot; data-end=&quot;6406&quot;&gt;The IoT Gateway is basically the &lt;strong data-start=&quot;6381&quot; data-end=&quot;6405&quot;&gt;communication bridge&lt;/strong&gt;.&lt;/p&gt;" vertex="1">
          <mxGeometry height="350" width="380" x="414" y="720" as="geometry" />
        </mxCell>
        <mxCell id="xX_1lbu7gcvtT0vsC2jS-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h1 data-section-id=&quot;fg7trk&quot; data-start=&quot;6139&quot; data-end=&quot;6162&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;11. Telemetry API&lt;/h1&gt;&lt;div&gt;&lt;p data-start=&quot;6612&quot; data-end=&quot;6653&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;Now Looplon receives the continuous data.&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br/&gt;&lt;p data-start=&quot;6655&quot; data-end=&quot;6684&quot;&gt;This is called &lt;strong data-start=&quot;6670&quot; data-end=&quot;6683&quot;&gt;telemetry&lt;/strong&gt;.&lt;/p&gt;&lt;br/&gt;&lt;p data-start=&quot;6686&quot; data-end=&quot;6698&quot;&gt;For example:&lt;/p&gt;&lt;br/&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6700&quot; data-end=&quot;6802&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;10:00 → 52V → 80% SOC → 35°C&lt;br/&gt;10:01 → 51.9V → 79% SOC → 36°C&lt;br/&gt;10:02 → 51.8V → 78% SOC → 37°C&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br/&gt;&lt;p data-start=&quot;6804&quot; data-end=&quot;6868&quot;&gt;The Telemetry API is responsible for receiving this information.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="380" x="810" y="720" as="geometry" />
        </mxCell>
        <mxCell id="xX_1lbu7gcvtT0vsC2jS-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h1 data-section-id=&quot;fg7trk&quot; data-start=&quot;6139&quot; data-end=&quot;6162&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;12. Telemetry Module&lt;/h1&gt;&lt;div&gt;&lt;p data-start=&quot;6968&quot; data-end=&quot;7017&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;Once Looplon receives telemetry, it processes it.&lt;/p&gt;&lt;p data-start=&quot;7019&quot; data-end=&quot;7031&quot;&gt;For example:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;7033&quot; data-end=&quot;7119&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;Received:&lt;br&gt;&lt;br&gt;Battery = BAT-000001&lt;br&gt;Temperature = 65°C&lt;br&gt;SOC = 30%&lt;br&gt;Voltage = 48V&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;7121&quot; data-end=&quot;7154&quot;&gt;The Telemetry Module understands:&lt;/p&gt;&lt;blockquote data-start=&quot;7156&quot; data-end=&quot;7192&quot;&gt;&lt;p data-start=&quot;7158&quot; data-end=&quot;7192&quot;&gt;&quot;This data belongs to BAT-000001.&quot;&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-start=&quot;7194&quot; data-end=&quot;7225&quot;&gt;Then it stores the information.&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;7227&quot; data-end=&quot;7296&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;Telemetry API&lt;br&gt;      ↓&lt;br&gt;Telemetry Module&lt;br&gt;      ↓&lt;br&gt;SQL Server&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;/div&gt;" vertex="1">
